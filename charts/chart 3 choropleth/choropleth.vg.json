{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 8 (choropleth map): total esports prize money won by players from each country, all years to Oct 2026.",
  "width": 720,
  "height": 380,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#FAFAF8",
        "stroke": "#D5D5D0",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#E6E6E1",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world_countries_110m_topo.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        },
        {
          "calculate": "datum.properties.name + ': no recorded prize money'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#CFCFCF",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "type": "nominal",
          "title": "Country"
        }
      }
    },
    {
      "data": {
        "url": "data/esports_earnings_by_country.csv",
        "format": {
          "type": "csv",
          "parse": {
            "iso_numeric": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "iso_numeric",
          "from": {
            "data": {
              "url": "data/world_countries_110m_topo.json",
              "format": {
                "type": "topojson",
                "feature": "countries"
              }
            },
            "key": "id"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.geo)"
        },
        {
          "calculate": "datum.total_prize_usd / 1000000",
          "as": "total_m"
        },
        {
          "calculate": "datum.total_prize_usd < 1e6 ? 'Under $1M' : datum.total_prize_usd < 1e7 ? '$1M to $10M' : datum.total_prize_usd < 5e7 ? '$10M to $50M' : datum.total_prize_usd < 1e8 ? '$50M to $100M' : 'Over $100M'",
          "as": "prize_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "prize_class",
          "type": "ordinal",
          "title": "Prize money won (US$)",
          "scale": {
            "domain": [
              "Under $1M",
              "$1M to $10M",
              "$10M to $50M",
              "$50M to $100M",
              "Over $100M"
            ],
            "range": [
              "#D6E4EF",
              "#A3C2DA",
              "#6F9CC0",
              "#3A6E9C",
              "#173F66"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 180,
            "titleOrient": "left",
            "labelLimit": 200,
            "titleLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "rank",
            "type": "ordinal",
            "title": "World rank"
          },
          {
            "field": "total_m",
            "type": "quantitative",
            "title": "Prize money (US$ millions)",
            "format": ",.1f"
          },
          {
            "field": "players",
            "type": "quantitative",
            "title": "Players who won prize money",
            "format": ","
          },
          {
            "field": "top_game",
            "type": "nominal",
            "title": "Top game"
          },
          {
            "field": "top_game_share_pct",
            "type": "quantitative",
            "title": "Top game's share (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/world_countries_110m_topo.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#C2702A",
        "strokeWidth": 2
      }
    },
    {
      "data": {
        "url": "data/esports_earnings_by_country.csv",
        "format": {
          "type": "csv",
          "parse": {
            "iso_numeric": "string"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.iso2 == 'AU'"
        },
        {
          "calculate": "'Australia ranks #' + datum.rank + ' in the world'",
          "as": "line1"
        },
        {
          "calculate": "'US$' + format(datum.total_prize_usd / 1000000, '.1f') + 'M won by ' + format(datum.players, ',') + ' players'",
          "as": "line2"
        },
        {
          "calculate": "[datum.line1, datum.line2]",
          "as": "label"
        },
        {
          "calculate": "160",
          "as": "lon"
        },
        {
          "calculate": "-46",
          "as": "lat"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#8A4A12",
        "lineHeight": 15
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Helvetica, Arial, sans-serif"
  }
}